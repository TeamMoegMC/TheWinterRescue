		{
			dependencies: ["0CF09A0965515E7C"]
			description: [
				"城镇居民的生存需要两大基本条件："
				"[ \"其一是充足的\", { \"text\": \"食物\", \"underlined\": \"true\", \"clickEvent\": { \"action\": \"change_page\", \"value\": \"2D5AB78B7C01225C\" } }, \"。\" ]"
				"[ \"其二是温暖的\", { \"text\": \"住所\", \"underlined\": \"true\", \"clickEvent\": { \"action\": \"change_page\", \"value\": \"0560EAC2DD2033D7\" } }, \"。\" ]"
				"[ \"任意一个基本条件的缺失都会使得居民的\", { \"text\": \"生命和精神\", \"underlined\": \"true\", \"clickEvent\": { \"action\": \"change_page\", \"value\": \"66FCBFC4EB72FB8F\" } }, \"快速减少，而当居民的生命或精神过低，居民便会死亡或离开城镇。\" ]"
			]
